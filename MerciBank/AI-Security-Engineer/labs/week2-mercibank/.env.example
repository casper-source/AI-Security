# Copy to .env  ->  cp .env.example .env

# The bearer token your Promptfoo harness must send. Any value; it just has to match what you put in
# your Promptfoo config's MERCI_TARGET_KEY.
MERCI_TARGET_KEY=merci-lab-key
PORT=8080

# --- MerciBank's brain: any OpenAI-compatible model endpoint (REQUIRED) ---
# Put ONE provider's values here. The target won't answer without a key (GET /health shows hasKey).
#
# IMPORTANT: use a model with reliable OpenAI-style function-calling, or the tool-driven findings
# (RAG injection, money transfer) won't fire. Verified good: openai/gpt-4o-mini. Some open models
# (e.g. some Llama builds on OpenRouter) emit malformed tool calls and won't exercise the tools well.

# Option A — OpenRouter (the cohort fallback key works here):
MERCI_LLM_BASE_URL=https://openrouter.ai/api/v1
MERCI_LLM_API_KEY=sk-or-...your-key...
MERCI_LLM_MODEL=openai/gpt-4o-mini

# Option B — OpenAI directly:
# MERCI_LLM_BASE_URL=https://api.openai.com/v1
# MERCI_LLM_API_KEY=sk-...your-key...
# MERCI_LLM_MODEL=gpt-4o-mini

# Option C — a local model (no key needed), e.g. Ollama with a tool-capable model:
# MERCI_LLM_BASE_URL=http://localhost:11434/v1
# MERCI_LLM_API_KEY=ollama
# MERCI_LLM_MODEL=qwen2.5:7b
