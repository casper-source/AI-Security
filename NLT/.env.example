# Copy this file to .env and fill in your own values.
# See docs/STUDENT_GUIDE.md for where to find these.

# RunPod "HTTP Service" URL for port 11434 (Connect tab in the RunPod dashboard).
# Only needed for docker-compose.windows-cloud.yml.
OLLAMA_CLOUD_URL=https://your-pod-id-11434.proxy.runpod.net

# AI Security Level: 1 (none) through 5 (full input+output filtering)
AI_SECURITY_LEVEL=1
